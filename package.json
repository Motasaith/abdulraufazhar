{
  "name": "abdul-rauf-portfolio",
  "version": "4.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && npx wrangler pages deploy out --project-name abdul-rauf-portfolio",
    "preview": "next build && wrangler pages dev out --port 8788"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.157.0"
  },
  "engines": {
    "node": ">=20"
  }
}